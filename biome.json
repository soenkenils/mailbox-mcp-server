{
	"$schema": "https://biomejs.dev/schemas/2.3.2/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 80,
		"lineEnding": "lf"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useConst": "error",
				"useTemplate": "error",
				"useNodejsImportProtocol": "error"
			},
			"complexity": {
				"useLiteralKeys": "error",
				"noUselessFragments": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noAsyncPromiseExecutor": "error"
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"noUnusedFunctionParameters": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"arrowParentheses": "asNeeded"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts", "**/__tests__/**"],
			"javascript": {
				"formatter": {
					"enabled": true
				}
			},
			"linter": {
				"rules": {
					"complexity": {
						"useArrowFunction": "off"
					},
					"suspicious": {
						"noExplicitAny": "warn"
					},
					"style": {
						"noNonNullAssertion": "warn"
					}
				}
			}
		},
		{
			"includes": [
				"src/services/CalendarService.ts",
				"src/services/ConnectionPool.ts",
				"src/services/SmtpService.ts",
				"src/tools/calendarTools.ts",
				"tests/CalendarService.test.ts",
				"tests/ImapConnectionPool.test.ts",
				"tests/SmtpConnectionPool.test.ts",
				"tests/SmtpService.test.ts",
				"tests/config.test.ts",
				"tests/validation.test.ts"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "warn",
						"noUnusedImports": "warn",
						"noUnusedFunctionParameters": "warn"
					}
				}
			}
		}
	]
}
