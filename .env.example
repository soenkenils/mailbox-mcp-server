# Mailbox.org MCP Server Configuration

# Required: Your mailbox.org credentials
MAILBOX_EMAIL=your-email@mailbox.org
MAILBOX_PASSWORD=your-app-password

# Optional: IMAP configuration (defaults shown)
MAILBOX_IMAP_HOST=imap.mailbox.org
MAILBOX_IMAP_PORT=993
MAILBOX_IMAP_SECURE=true

# Optional: CalDAV configuration (defaults shown) 
MAILBOX_CALDAV_URL=https://dav.mailbox.org/

# Optional: Specific calendars to access (comma-separated), matched by exact
# display name, URL or last URL segment. The only calendars that are read,
# and that create/update/delete_calendar_event may write to; the first is
# the default for create_calendar_event.
# MAILBOX_CALENDARS=personal,work,family

# Optional: Cache size and cleanup settings
CACHE_MAX_SIZE=1000
CACHE_CLEANUP_INTERVAL=300000

# Optional: IMAP connections kept open while idle
# Defaults to 1 in stdio mode and 0 (connect on demand) in http mode
# POOL_MIN_CONNECTIONS=1

# Optional: Transport selection (defaults shown)
# stdio is what Claude Desktop launches locally; http serves MCP over
# Streamable HTTP for hosted deployments (see README "Hosted Mode").
# Put a TLS-terminating proxy in front of http mode.
MCP_TRANSPORT=stdio
PORT=8080

# Required in http mode: shared secret for every MCP request
# Generate with: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Optional: Enable debug logging
DEBUG=false