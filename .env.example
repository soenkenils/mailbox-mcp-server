# Mailbox.org MCP Server Configuration
#
# The server reads environment variables only; it does not load this file
# itself. Bun loads .env from the working directory; with node use
# `node --env-file=.env dist/main.js`. Claude Desktop needs the variables in
# the server's "env" block instead.

# Required: Your mailbox.org credentials (an app password is recommended)
MAILBOX_EMAIL=your-email@mailbox.org
MAILBOX_PASSWORD=your-app-password

# Optional: IMAP configuration (defaults shown)
# MAILBOX_IMAP_HOST=imap.mailbox.org
# MAILBOX_IMAP_PORT=993
# MAILBOX_IMAP_SECURE=true

# Optional: SMTP configuration (defaults shown)
# true = implicit TLS (port 465); false = STARTTLS, which is then required (port 587)
# MAILBOX_SMTP_HOST=smtp.mailbox.org
# MAILBOX_SMTP_PORT=465
# MAILBOX_SMTP_SECURE=true

# Optional: CalDAV configuration (defaults shown)
# MAILBOX_CALDAV_URL=https://dav.mailbox.org/

# Optional: Specific calendars to access (comma-separated), matched by exact
# display name, URL or last URL segment. The only calendars that are read,
# and that create/update/delete_calendar_event may write to; the first is
# the default for create_calendar_event.
# MAILBOX_CALENDARS=personal,work,family

# Optional: ManageSieve configuration (defaults shown)
# false = plain connection upgraded with mandatory STARTTLS (standard port 4190);
# true = implicit TLS, only for servers with a dedicated TLS port
# MAILBOX_SIEVE_HOST=imap.mailbox.org
# MAILBOX_SIEVE_PORT=4190
# MAILBOX_SIEVE_SECURE=false

# Optional: Cache size and cleanup interval in ms (defaults shown).
# Cache lifetimes are fixed in code; the CACHE_*_TTL variables are still
# accepted but have no effect.
# CACHE_MAX_SIZE=1000
# CACHE_CLEANUP_INTERVAL=300000

# Optional: Connection pools
# IMAP connections kept open while idle: defaults to 1 in stdio mode and
# 0 (connect on demand) in http mode; must not exceed POOL_MAX_CONNECTIONS
# POOL_MIN_CONNECTIONS=1
# Maximum IMAP connections (default 3); also caps SMTP at min(5, value)
# POOL_MAX_CONNECTIONS=3
# Timeouts in ms (defaults shown)
# POOL_TIMEOUT_MS=15000
# POOL_IDLE_TIMEOUT_MS=30000
# POOL_HEALTH_CHECK_MS=6000

# Optional: Transport selection (defaults shown)
# stdio is what Claude Desktop and Claude Code launch locally; http serves
# MCP over Streamable HTTP for hosted deployments (see README "Hosted Mode").
# Put a TLS-terminating proxy in front of http mode.
# MCP_TRANSPORT=stdio
# PORT=8080

# Required in http mode: shared secret for every MCP request, at least 32
# characters. Generate with: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Optional: public origin without a path, e.g. https://mcp.example.com
# Enables OAuth, which needs a stable URL for discovery metadata and redirects
# PUBLIC_URL=

# Optional: hosts an OAuth client may register a redirect URI for
# Defaults to claude.ai,claude.com; loopback is always permitted
# OAUTH_ALLOWED_REDIRECT_HOSTS=

# Optional: Enable debug logging (default false)
# DEBUG=false
